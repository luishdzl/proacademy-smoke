{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proacademy-smoke",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  }
}
